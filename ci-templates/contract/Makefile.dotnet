# Makefile contract - .NET starter.
# Test projects need packages: coverlet.msbuild, JunitXml.TestLogger
.PHONY: setup lint test coverage build

setup:
	dotnet restore

lint:
	dotnet format --verify-no-changes
	dotnet build --no-restore -warnaserror

test:
	dotnet test --no-restore

coverage:
	mkdir -p reports
	dotnet test --no-restore \
	  --logger "junit;LogFilePath=$(CURDIR)/reports/junit-{assembly}.xml" \
	  -p:CollectCoverage=true '-p:CoverletOutputFormat="json,cobertura"' -m:1 \
	  -p:CoverletOutput=$(CURDIR)/reports/ -p:MergeWith=$(CURDIR)/reports/coverage.json
	mv reports/coverage.cobertura.xml reports/coverage.xml

build:
	dotnet publish -c Release -o dist
